function(AddTest TEST_NAME TEST_SOURCE)
    add_executable(${TEST_NAME}
        ${TEST_SOURCE}
    )

    target_link_libraries(${TEST_NAME}
        PRIVATE {{ .LibName }}
    )

    add_test(NAME ${TEST_NAME} COMMAND ${TEST_NAME})
endfunction()

{{- range .Tests }}
AddTest({{ .Name }} {{ .Source }})
{{- end }}